{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"] }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/workers/**/*.ts",
    "src/core/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  // Renderer tests import renderer sources, which need the DOM lib — they belong
  // to the web project, not this one.
  "exclude": ["tests/renderer/**"]
}
